# Telegram Bot Token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Telegram Group Chat IDs (Must be integers, e.g. -1001234567890)
SOURCE_GROUP_ID=-1001234567890
DELIVERY_GROUP_ID=-1009876543210

# Admin Telegram User IDs (Comma-separated integer user IDs)
ADMIN_IDS=123456789,987654321

# Database Connection String
# SQLite default (Local): sqlite+aiosqlite:///bot_database.db
# PostgreSQL (Railway): postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///bot_database.db

# Media Group Debounce Window (in seconds)
MEDIA_GROUP_TIMEOUT=2.0

# User Session Timeout (in seconds, default 300.0 = 5 minutes)
USER_SESSION_TIMEOUT=300.0

# Post-delivery cleanup option (true/false)
DELETE_AFTER_DELIVERY=false

# Telegram API Retry Configuration
MAX_RETRY=3
RETRY_DELAY=2.0

# Automatic Storage Retention Cleanup (in days, set 0 to disable)
CLEANUP_DAYS=30
